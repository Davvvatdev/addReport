datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Report {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now())
  occurredAt      DateTime @default(now())
  mode            String   // "metro" | "bus" | "brt"
  lineId          String?
  stationId       String?
  direction       String?  // نام ایستگاه مقصد | unknown
  vehicleContext  String   // "in_station" | "on_vehicle" | "transfer_point"
  categoryId      String
  subcategoryId   String
  description     String?
  photoUrl        String?
  lat             Float?
  lng             Float?
  severity        String   @default("medium") // "low" | "medium" | "high" | "critical"
  impact          String?  // "time_loss" | "could_not_board" | "safety_risk" | "health" | "accessibility"
  tripPurpose     String?
  riderType       String?
  accessNeed      String?
  gender          String?
  isAnonymous     Boolean  @default(true)
  reporterToken   String
  userId          String?
  status          String   @default("submitted") // "submitted" | "under_review" | "assigned" | "in_progress" | "resolved" | "rejected"
  assignedUnit    String?
  statusNote      String?
  updatedAt       DateTime @default(now()) @updatedAt
  syncStatus      String   @default("synced") // "synced" | "pending"

  line            Line?        @relation(fields: [lineId], references: [id])
  station         Station?     @relation(fields: [stationId], references: [id])
  category        Category     @relation(fields: [categoryId], references: [id])
  subcategory     Subcategory  @relation(fields: [subcategoryId], references: [id])
  user            User?        @relation(fields: [userId], references: [id])
  events          ReportEvent[]
  confirmations   ReportConfirmation[]
  resolutionVotes ResolutionVote[]

  @@index([stationId, subcategoryId, occurredAt])
  @@index([reporterToken])
  @@map("reports")
}

model ReportEvent {
  id           String   @id @default(uuid())
  reportId     String
  status       String
  assignedUnit String?
  note         String?
  createdAt    DateTime @default(now())
  report       Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("report_events")
}

model ReportConfirmation {
  id            String   @id @default(uuid())
  reportId      String
  reporterToken String
  createdAt     DateTime @default(now())
  report        Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, reporterToken])
  @@map("report_confirmations")
}

model ResolutionVote {
  id            String   @id @default(uuid())
  reportId      String
  reporterToken String
  resolved      Boolean
  createdAt     DateTime @default(now())
  report        Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, reporterToken])
  @@map("resolution_votes")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  reports      Report[]

  @@map("users")
}

model Line {
  id      String   @id @default(uuid())
  name    String
  mode    String   // "metro" | "bus" | "brt"
  color   String?
  reports Report[]

  @@map("lines")
}

model Station {
  id            String   @id @default(uuid())
  name          String
  lines         String   // JSON string of lines
  lat           Float?
  lng           Float?
  isInterchange Boolean  @default(false)
  sortOrder     Int      @default(0)
  lineOrders    String   @default("{}")
  reports       Report[]

  @@map("stations")
}

model Category {
  id            String        @id
  titleFa       String
  sortOrder     Int           @default(0)
  icon          String?
  subcategories Subcategory[]
  reports       Report[]

  @@map("categories")
}

model Subcategory {
  id           String   @id
  categoryId   String
  titleFa      String
  allowsPhoto  Boolean  @default(false)
  isSensitive  Boolean  @default(false)
  sortOrder    Int      @default(0)
  icon         String?
  isOther      Boolean  @default(false) // «خودم می‌نویسم» — توضیح متنی اجباری
  modes        String   @default("metro,bus,brt") // وسیله‌هایی که این مورد برایشان نمایش داده می‌شود
  category     Category @relation(fields: [categoryId], references: [id])
  reports      Report[]

  @@map("subcategories")
}

model Feedback {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  susScores     String   // JSON string
  freeComment   String?
  reporterToken String

  @@map("feedback")
}

